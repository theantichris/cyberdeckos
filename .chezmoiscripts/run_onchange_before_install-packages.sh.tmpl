#!/bin/sh
set -eu

{{ range .packages.pacman }}
if ! pacman -Qq {{ . | shellQuote }} >/dev/null 2>&1; then
    sudo pacman -S --needed {{ . | shellQuote }}
fi
{{ end }}

{{ range .packages.aur }}
if ! pacman -Qq {{ . | shellQuote }} >/dev/null 2>&1; then
    shelly install aur {{ . | shellQuote }}
fi
{{ end }}

sudo pacman -D --asexplicit -- \
    {{ .packages.pacman | shellQuoteList | join " " }} \
    {{ .packages.aur | shellQuoteList | join " " }}

{{ range .packages.uv }}
uv tool install {{ . | shellQuote }}
{{ end }}

{{ range .packages.remove }}
if pacman -Qq -- {{ . | shellQuote }} >/dev/null 2>&1; then
    sudo pacman -Rns -- {{ . | shellQuote  }}
fi
{{ end }}
